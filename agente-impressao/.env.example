# Copie este arquivo para ".env" e preencha.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA

# Usuário do sistema (liberado) que o agente usa para entrar. Sugestão: crie um usuário só para isso.
AGENTE_EMAIL=impressora@suaempresa.com
AGENTE_SENHA=troque-esta-senha

# Nome deste computador (aparece como "conectado" no sistema)
AGENTE_NOME=PC-IMPRESSORA

# Opcional: imprimir só as etiquetas de uma filial (id da filial). Vazio = todas.
FILIAL_ID=

# Nome do COMPARTILHAMENTO da impressora no Windows (o mesmo usado no GACFOOD).
IMPRESSORA_COMPARTILHAMENTO=Label9x10

# Pausa entre uma etiqueta e outra, em milissegundos (mínimo 200, máximo 10000). Se a impressora se atrapalhar, aumente.
INTERVALO_MS=1000

# Acentos: 0 = imprime sem acento (seguro). 1 = tenta imprimir com acento (teste antes!).
MANTER_ACENTOS=0
